# Template for data/.env
#
# Both keys must stay stable for good:
#   ENCRYPTION_KEY  decrypts the stored DFB credentials
#   JWT_SECRET_KEY  keeps existing logins valid
# If they are lost, every user has to re-enter their DFB credentials.
#
# If data/.env is missing entirely at startup, the application generates both
# keys itself. This file is only needed when you want to supply values.

# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=90

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Only relevant when running outside Docker
# (inside the container the Dockerfile sets these values)
API_HOST=0.0.0.0
API_PORT=8001

# Downloads: documents are generated anew on every request.
# Each PDF conversion starts a LibreOffice process (150-300 MB), hence the
# limit. MAX_BULK_DOWNLOAD caps the size of a bulk ZIP.
PDF_MAX_CONCURRENCY=2
MAX_BULK_DOWNLOAD=50

# Enables POST /api/scheduler/trigger (starts the fetch for ALL accounts).
# Disabled by default - this project has no roles.
# ALLOW_SCHEDULER_TRIGGER=1

# Map for the travel costs. The defaults are the public OpenStreetMap services;
# resolved addresses are afterwards kept permanently in app.db.
# For your own instance, point both addresses elsewhere - no code changes needed.
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# GEOCODER_MIN_INTERVAL=1.0
# Mileage suggestions and estimated travel costs: an OSRM route planner, by
# default the one from OpenStreetMap Germany. Only coordinates are sent out.
# ROUTING_URL=https://routing.openstreetmap.de/routed-car
# ROUTING_MIN_INTERVAL=1.0
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap-Mitwirkende

# Bug reports from the "Fehler melden" (report a bug) tab. Without these
# settings the tab is visible but says that no outgoing mail is set up -
# no report is ever silently discarded.
# SMTP_PORT 465 speaks TLS immediately, 587 upgrades with STARTTLS.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# BUGREPORT_EMPFAENGER=spesen-generator@jan-vogt.dev
