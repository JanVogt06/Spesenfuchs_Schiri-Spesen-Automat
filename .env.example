# Vorlage fuer data/.env
#
# Beide Schluessel muessen dauerhaft stabil bleiben:
#   ENCRYPTION_KEY  entschluesselt die gespeicherten DFB-Zugangsdaten
#   JWT_SECRET_KEY  haelt bestehende Logins gueltig
# Gehen sie verloren, muessen alle Nutzer ihre DFB-Zugangsdaten neu eintragen.
#
# Fehlt data/.env beim Start komplett, erzeugt die Anwendung beide Schluessel
# selbst. Diese Datei ist also nur noetig, wenn Werte vorgegeben werden sollen.

# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=90

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Nur fuer den Betrieb ausserhalb von Docker relevant
# (im Container setzt das Dockerfile diese Werte)
API_HOST=0.0.0.0
API_PORT=8001

# Downloads: Dokumente entstehen bei jedem Abruf neu.
# Jede PDF-Konvertierung startet einen LibreOffice-Prozess (150-300 MB),
# darum die Begrenzung. MAX_BULK_DOWNLOAD deckelt die Groesse eines Sammel-ZIP.
PDF_MAX_CONCURRENCY=2
MAX_BULK_DOWNLOAD=50
